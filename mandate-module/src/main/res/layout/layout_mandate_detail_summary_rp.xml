<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="vm"
            type="com.rocketpay.mandate.feature.mandate.presentation.ui.mandatedetail.viewmodel.MandateDetailUM" />

        <import type="android.view.View" />
    </data>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/rp_blue_2" />

        <LinearLayout
            style="@style/rp_surface_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/rp_size_8"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/rp_size_16">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@{vm.itemBadge.text}"
                    android:textAppearance="@style/rp_title"
                    android:textColor="@{vm.itemBadge.textColor}"
                    tools:text="Mandate Pending" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textAppearance="@style/rp_heading"
                    android:textColor="@{vm.amountColor}"
                    app:textWithNullCheck="@{vm.amount}"
                    tools:text="2,00,000" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/rp_yellow_2"
                android:visibility="@{vm.retryMessageVisibility}" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/rp_yellow_3"
                android:gravity="start"
                android:paddingHorizontal="@dimen/rp_size_16"
                android:paddingVertical="@dimen/rp_size_10"
                android:text="@{vm.retryMessageText}"
                android:textAppearance="@style/rp_body_regular_medium"
                android:textColor="@color/rp_grey_1"
                android:visibility="@{vm.retryMessageVisibility}"
                tools:text="@string/rp_upi_autopay_request_sent_to" />

        </LinearLayout>

    </FrameLayout>

</layout>

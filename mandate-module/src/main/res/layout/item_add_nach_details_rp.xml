                <!--                android:onClick="@{() -> vm.onChargeClick()}"-->
                <!--                android:text="@string/rp_what_is_upi_auto_pay_nach" />-->

            </LinearLayout>

            <include
                layout="@layout/layout_penalty_rp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/rp_size_4"
                android:visibility="@{vm.isPenaltyEnabled() ? View.VISIBLE : View.GONE}"
                app:vm="@{vm.itemPenaltyVm}" />
        </LinearLayout>
    </FrameLayout>

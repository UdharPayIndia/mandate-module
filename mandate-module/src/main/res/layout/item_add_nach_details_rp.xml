                <!--                            android:layout_width="match_parent"-->
                <!--                            android:layout_height="wrap_content"-->
                <!--                            android:layout_marginStart="@dimen/rp_size_8"-->
                <!--                            android:text="@string/rp_net_banking_debit_card" />-->

                <!--                    </LinearLayout>-->

                <!--                </LinearLayout>-->

                <!--            </LinearLayout>-->

                <!--            <TextView-->
                <!--                android:textAppearance="@style/rp_cta_small"-->
                <!--                android:layout_width="wrap_content"-->
                <!--                android:layout_height="wrap_content"-->
                <!--                android:layout_marginTop="@dimen/rp_size_8"-->

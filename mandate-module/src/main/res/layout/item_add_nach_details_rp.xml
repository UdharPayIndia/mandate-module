                <!--                    android:src="@{vm.nashDrawable}"-->
                <!--                    app:tint="@color/rp_blue_2"-->
                <!--                    tools:src="@drawable/rp_ic_radio_filled"-->
                <!--                    tools:ignore="ContentDescription" />-->

                <!--                <LinearLayout-->
                <!--                    android:layout_width="0dp"-->

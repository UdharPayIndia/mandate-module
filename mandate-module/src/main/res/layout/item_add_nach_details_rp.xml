<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="vm"
            type="com.rocketpay.mandate.feature.mandate.presentation.ui.mandateadd.viewmodel.MandateAddUM" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="@{vm.paymentDetailVisibility ? View.VISIBLE : View.GONE}">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                style="@style/rp_surface_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/rp_size_4"
                android:orientation="vertical"
                android:paddingVertical="@dimen/rp_size_16"
                android:paddingStart="@dimen/rp_size_16"
                android:paddingEnd="@dimen/rp_size_8">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/rp_size_4"
                    android:text="@string/rp_select_payment_method"
                    android:textAppearance="@style/rp_body_regular_medium"
                    android:textColor="@color/rp_grey_1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/rp_size_4"
                        android:background="@drawable/rp_ripple_card"
                        android:clickable="@{vm.enableUpiLayout}"
                        android:onClick="@{() -> vm.onUpiClick()}"
                        android:orientation="horizontal"
                        android:visibility="@{vm.upiLayoutVisibility}">

                        <ImageView
                            android:layout_width="@dimen/rp_size_24"
                            android:layout_height="@dimen/rp_size_24"
                            android:layout_marginVertical="@dimen/rp_size_8"
                            android:layout_marginEnd="@dimen/rp_size_8"
                            android:alpha="@{vm.upiLayoutAlpha}"
                            android:src="@{vm.upiDrawable}"
                            app:tint="@color/rp_blue_2"
                            tools:ignore="ContentDescription"
                            tools:src="@drawable/rp_ic_radio_filled" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="@dimen/rp_size_8"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/iv_autopay"
                                    android:layout_width="@dimen/rp_size_200"
                                    android:layout_height="@dimen/rp_size_24"
                                    android:layout_gravity="center_vertical"
                                    android:alpha="@{vm.upiLayoutAlpha}"
                                    android:src="@drawable/rp_ic_upi_apps_logo"
                                    app:layout_constrainedWidth="true"
                                    tools:ignore="ContentDescription" />

                                <TextView
                                    android:id="@+id/tv_autopay"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:layout_marginStart="@dimen/rp_size_8"
                                    android:text="@string/rp_auto_pay"
                                    android:textAppearance="@style/rp_title" />

                            </LinearLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@{vm.upiAmountLimitError}"
                                android:textAppearance="@style/rp_body_small"
                                android:textColor="@color/rp_red_1"
                                android:visibility="@{vm.upiAmountLimitExceededVisibility}"
                                tools:text="@string/rp_upi_amount_limit_exceeded" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!--            <LinearLayout-->
                <!--                android:layout_width="match_parent"-->

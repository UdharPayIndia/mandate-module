<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="vm"
            type="com.rocketpay.mandate.feature.aboutus.presentation.ui.viewmodel.AboutUsUM"/>

        <import type="android.view.View" />

        <import type="android.text.TextUtils"/>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/rp_size_8"
            android:gravity="center"
            android:onClick="@{() -> vm.onTermsAndConditionClick()}"
            android:background="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_margin="@dimen/rp_size_8">

                <TextView
                    android:textAppearance="@style/rp_body_regular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@string/rp_terms_n_condition" />

            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/rp_size_20"
                android:layout_height="@dimen/rp_size_20"
                android:padding="@dimen/rp_size_4"
                android:layout_margin="@dimen/rp_size_8"
                android:src="@drawable/rp_ic_forward"
                app:tint="@color/rp_grey_4"
                tools:ignore="ContentDescription"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/rp_divider_hr"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/rp_size_8"
            android:gravity="center"
            android:onClick="@{() -> vm.onPrivacyPolicyClick()}"
            android:background="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_margin="@dimen/rp_size_8">

                <TextView
                    android:textAppearance="@style/rp_body_regular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@string/rp_privacy_policy" />

            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/rp_size_20"
                android:layout_height="@dimen/rp_size_20"
                android:padding="@dimen/rp_size_4"
                android:layout_margin="@dimen/rp_size_8"
                android:src="@drawable/rp_ic_forward"
                app:tint="@color/rp_grey_4"
                tools:ignore="ContentDescription"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/rp_divider_hr"/>


    </LinearLayout>

</layout>

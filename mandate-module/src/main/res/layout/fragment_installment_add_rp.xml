<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View"/>

        <variable
            name="vm"
            type="com.rocketpay.mandate.feature.installment.presentation.ui.installmentadd.viewmodel.InstallmentAddUM" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/rp_grey_6">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/RpMyTextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/rp_size_16"
                        android:hint="@string/rp_enter_installment_amount"
                        app:errorIconDrawable="@null"
                        app:errorText="@{vm.amountErrorMessage}">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_mobile_number"
                            style="@style/RpMyEditText"
                            android:layout_width="match_parent"
                            android:inputType="phone"
                            android:onTextChanged="@{(text,a,b,c) -> vm.updateMobileNumber(text)}"
                            android:onFocusChange="@{(v, hasFocus) -> vm.onMobileNumberFocusChanged(hasFocus)}"
                            android:text="@{vm.amount}" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start|center"
                        android:layout_marginStart="@dimen/rp_size_16"
                        android:layout_marginEnd="@dimen/rp_size_16"
                        android:background="@drawable/rp_background_card_cta"
                        android:onClick="@{() -> vm.onStartDateClick()}"
                        android:orientation="horizontal"
                        android:padding="@dimen/rp_size_8">

                        <ImageView
                            android:layout_width="@dimen/rp_size_24"
                            android:layout_height="24dp"
                            android:layout_marginStart="@dimen/rp_size_8"
                            android:src="@drawable/rp_ic_calendar"
                            app:tint="@color/rp_blue_2"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/rp_size_8"
                            android:includeFontPadding="false"
                            android:text="@{vm.dueDate}"
                            android:textAppearance="@style/rp_cta_regular"
                            android:textColor="@color/rp_blue_2"
                            tools:text="@string/rp_collection_start_date" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="bottom">

            <LinearLayout
                style="@style/rp_bottom_sheet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="bottom">

                <com.google.android.material.button.MaterialButton
                    style="@style/rp_cta_regular"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/rp_size_56"
                    android:layout_marginStart="@dimen/rp_size_16"
                    android:layout_marginEnd="@dimen/rp_size_16"
                    android:layout_marginBottom="@dimen/rp_size_16"
                    android:includeFontPadding="false"
                    android:insetTop="@dimen/rp_size_0"
                    android:insetBottom="@dimen/rp_size_0"
                    android:text="@{vm.submitOrVerify}"
                    android:enabled="@{vm.submitOrVerifyEnable}"
                    android:onClick="@{() -> vm.submitOrVerifyOtpClick()}"
                    tools:text="@string/rp_create_installment_verify_otp"/>

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</layout>

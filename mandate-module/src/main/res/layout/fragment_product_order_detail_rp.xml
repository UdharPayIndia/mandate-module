<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="vm"
            type="com.rocketpay.mandate.feature.product.presentation.ui.order.detail.viewmodel.ProductOrderDetailUM"/>
        <import type="android.text.TextUtils"/>
        <import type="android.view.View"/>

    </data>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/rp_size_64"
                    android:background="@{vm.toolbarBackground}"
                    tools:background="@color/rp_blue_2"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/rp_size_12">

                    <LinearLayout
                        style="@style/rp_surface_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/rp_size_8"
                        android:layout_marginEnd="@dimen/rp_size_8"
                        android:layout_marginBottom="@dimen/rp_size_4">

                        <TextView
                            android:textAppearance="@style/rp_body_small"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/rp_size_16"
                            android:layout_marginStart="@dimen/rp_size_16"
                            android:layout_marginEnd="@dimen/rp_size_16"
                            android:layout_marginBottom="@dimen/rp_size_16"
                            android:text="@{vm.titleText}"
                            tools:text="@string/rp_key_purchased" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginStart="@dimen/rp_size_16"
                            android:layout_marginEnd="@dimen/rp_size_16"
                            android:layout_marginBottom="@dimen/rp_size_16">

                            <ImageView
                                android:id="@+id/iv_logo"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@{vm.iconDrawable}"
                                tools:src="@drawable/rp_ic_super_key"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>

                            <TextView
                                android:textAppearance="@style/rp_body_regular"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/rp_size_12"
                                android:layout_gravity="center_vertical"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@{vm.quantityText}"
                                tools:text="Rahulkumar" />

                            <TextView
                                android:textAppearance="@style/rp_body_regular_medium"
                                android:paddingStart="@dimen/rp_size_8"
                                android:paddingEnd="@dimen/rp_size_8"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:text="@{vm.amount}"
                                android:textColor="@{vm.amountTextColor}"
                                tools:textColor="@color/rp_grey_1"
                                android:gravity="center"
                                tools:text="Finished" />


                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

            <LinearLayout
                style="@style/rp_surface_1"
                android:layout_marginStart="@dimen/rp_size_8"
                android:layout_marginEnd="@dimen/rp_size_8"
                android:layout_marginTop="@dimen/rp_size_4"
                android:layout_marginBottom="@dimen/rp_size_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:textAppearance="@style/rp_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/rp_size_16"
                    android:layout_marginStart="@dimen/rp_size_16"
                    android:layout_marginEnd="@dimen/rp_size_16"
                    android:layout_marginBottom="@dimen/rp_size_16"
                    android:text="@string/rp_other_details" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/rp_size_16"
                    android:layout_marginEnd="@dimen/rp_size_16"
                    android:layout_marginBottom="@dimen/rp_size_12"
                    android:visibility="@{vm.isRedeemOrderType() ? View.GONE : View.VISIBLE}">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:textAppearance="@style/rp_body_small"
                                android:textColor="@color/rp_grey_3"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:text="@string/rp_product_order_id"/>

                            <TextView
                                android:textAppearance="@style/rp_body_large"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:visibility="@{TextUtils.isEmpty(vm.installmentUtr) ? View.GONE : View.VISIBLE}"
                                android:text="@{vm.installmentUtr}"
                                tools:text="219894829802"/>

                        </LinearLayout>

                        <ImageView
                            android:layout_width="@dimen/rp_size_36"
                            android:layout_height="@dimen/rp_size_36"
                            android:padding="10dp"
                            android:layout_gravity="center"
                            android:src="@drawable/rp_ic_copy"
                            app:tint="@color/rp_blue_2"
                            android:onClick="@{() -> vm.onRocketPayTransactionIdCopyClick()}"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            tools:ignore="ContentDescription" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:textAppearance="@style/rp_body_small"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="@{vm.isRedeemOrderType() &amp;&amp; vm.referenceVisibility ? View.VISIBLE : View.GONE}"
                    android:layout_marginStart="@dimen/rp_size_16"
                    android:layout_marginEnd="@dimen/rp_size_16"
                    android:text="@{vm.referenceType}"
                    tools:text="@string/rp_other_details" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/rp_size_8"
                    android:paddingStart="@dimen/rp_size_8"
                    android:paddingEnd="@dimen/rp_size_8"
                    android:paddingTop="@dimen/rp_size_12"
                    android:visibility="@{vm.isRedeemOrderType() &amp;&amp; vm.referenceVisibility ? View.VISIBLE : View.GONE}"
                    android:layout_marginStart="@dimen/rp_size_16"
                    android:layout_marginEnd="@dimen/rp_size_16"
                    android:layout_marginBottom="@dimen/rp_size_12"
                    android:paddingBottom="@dimen/rp_size_12"
                    android:orientation="horizontal"
                    android:background="@drawable/rp_background_card_item"
                    android:foreground="?attr/selectableItemBackground"
                    android:onClick="@{() -> vm.onReferenceClick()}">

                    <LinearLayout
                        android:id="@+id/lyt_customer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/rp_size_16"
                        android:orientation="vertical"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/lyt_status"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <TextView
                            android:textAppearance="@style/rp_body_regular"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@{vm.referenceNameText}"
                            tools:text="Rahulkumar" />

                        <TextView
                            android:textAppearance="@style/rp_body_small"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAllCaps="false"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@{vm.referenceDateText}"
                            tools:text="1000 due in 13 days" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/lyt_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginEnd="@dimen/rp_size_8"
                        android:gravity="end"
                        app:layout_constraintEnd_toStartOf="@+id/ivArrow"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <TextView
                            android:textAppearance="@style/rp_num_regular"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:layout_gravity="end"
                            app:textWithNullCheck="@{vm.referenceAmountText}"
                            tools:text="₹50,000" />

                        <TextView
                            android:textAppearance="@style/rp_header"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:gravity="end"
                            android:paddingStart="@dimen/rp_size_8"
                            android:paddingEnd="@dimen/rp_size_8"
                            android:paddingTop="@dimen/rp_size_2"
                            android:paddingBottom="@dimen/rp_size_2"
                            android:text="@{vm.referenceInfoText}"
                            android:textColor="@{vm.referenceInfoSubtitleColor}"
                            android:background="@{vm.referenceInfoBackgroundDrawable}"
                            tools:text="1000 due in 13 days" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivArrow"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:padding="@dimen/rp_size_4"
                        android:layout_gravity="center_vertical"
                        android:src="@drawable/rp_ic_forward"
                        app:tint="@color/rp_grey_4"
                        tools:ignore="ContentDescription"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</layout>
